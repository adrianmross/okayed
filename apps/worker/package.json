    "@okayed/client": "workspace:*",
    "@okayed/connectors": "workspace:*",
    "@okayed/core": "workspace:*",
    "@okayed/engine": "workspace:*",
    "@okayed/grant": "workspace:*",
    "@okayed/interop": "workspace:*",
    "@okayed/mcp": "workspace:*",
    "agents": "^0.31.0",
    "ai": "^7.0.157",
    "workers-ai-provider": "^4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.5",
    "wrangler": "^4.155.0"
  }
