{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okayed",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers AI: Llama 3.3 drafts and explains. Free daily allocation; no paid plan needed.
  "ai": { "binding": "AI" },
  // One Durable Object per person (SQLite-backed, available on the free plan).
  "durable_objects": {
    "bindings": [{ "name": "OkayedAgent", "class_name": "OkayedAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OkayedAgent"] }],
  // The grant lifecycle: propose → await confirm → issue → await revoke or expiry.
  "workflows": [
    { "name": "okayed-grant-lifecycle", "binding": "GRANT_LIFECYCLE", "class_name": "GrantLifecycle" }
  ],
  "vars": {
    // "workers-ai" or "heuristic" (no model; useful offline).
    "DRAFTER": "workers-ai",
    "MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  // Secrets (wrangler secret put): ISSUER_SECRET (64 hex chars), GITHUB_TOKEN (optional, for the demo tool).
  "observability": { "enabled": true },
  "env": {
    // `wrangler dev --env local`: everything but Workers AI, so it runs without a Cloudflare login.
    "local": {
      "durable_objects": {
        "bindings": [{ "name": "OkayedAgent", "class_name": "OkayedAgent" }]
      },
      "workflows": [
        { "name": "okayed-grant-lifecycle", "binding": "GRANT_LIFECYCLE", "class_name": "GrantLifecycle" }
      ],
      "vars": { "DRAFTER": "heuristic" }
    }
  }
}
